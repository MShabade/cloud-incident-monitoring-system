# Copy to .env on the EC2 instance (never commit real values)
# cp .env.example .env && nano .env

NODE_ENV=production
PORT=5000

# MongoDB Atlas connection string
# Atlas → Database → Connect → Drivers → copy URI
# Network Access: add EC2 Elastic IP (or 0.0.0.0/0 for testing only)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/cloudops?retryWrites=true&w=majority

# Generate: openssl rand -base64 48
JWT_SECRET=replace-with-long-random-secret

# Public URL of your app (used by CORS + Socket.IO)
# Examples: http://54.123.45.67  or  https://incidents.yourcompany.com
CLIENT_ORIGIN=http://YOUR_EC2_PUBLIC_IP

# Optional: shared secret for cloud webhook ingestion
WEBHOOK_SECRET=replace-with-webhook-secret

# Optional: external cost API URL
# COST_API_URL=https://your-billing-api.example.com/metrics
